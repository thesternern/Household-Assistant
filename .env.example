# ─── core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Anthropic API key for the agent runtime (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Locally: postgres://<you>@localhost:5432/home_assistant
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://localhost:5432/home_assistant

# Public https base URL of this service (Railway gives you one).
# Used for Telegram + Vapi webhooks and the Google OAuth redirect.
APP_URL=https://your-app.up.railway.app

# 32+ random chars. Encrypts Google refresh tokens and site credentials.
# Generate: openssl rand -base64 48
APP_SECRET=

# ─── telegram ────────────────────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Random string; becomes part of the webhook path AND the secret-token header.
# Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Numeric user IDs from @userinfobot — the whitelist. Nobody else can talk to it.
TELEGRAM_USER_ID_1=
TELEGRAM_USER_ID_2=

# ─── models ──────────────────────────────────────────────────────────────────
DEFAULT_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5
# Tidies the grocery list: merges near-duplicates, rewrites quantities into what a shop sells.
GROCERY_MODEL=claude-opus-5
# Agent SDK session store. Point at the Railway volume so sessions survive deploys.
CLAUDE_CONFIG_DIR=/data/claude

# ─── household ───────────────────────────────────────────────────────────────
HOUSEHOLD_TIMEZONE=America/Los_Angeles
# Optional, for the weather line in the morning brief (open-meteo, no key needed)
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# ─── google (Gmail + Calendar, your account only) ─────────────────────────
# GCP OAuth 2.0 "Web application" client. Authorised redirect URI must be
# exactly:  ${APP_URL}/oauth/google/callback
# Enable the Gmail API and Google Calendar API on the project.
# Publish the consent screen to "In production" — Testing-mode refresh tokens
# expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── vapi (phone calls) ──────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# Leave true until you have watched a dry run end-to-end. true = no real call is
# ever placed; the full webhook path is simulated.
DRY_RUN_CALLS=true

# ─── twilio (text messages) ──────────────────────────────────────────────────
# From console.twilio.com. The SID's shape is checked, not just its presence, so
# a placeholder cannot read as configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The household's own number, E.164. Voice goes through Vapi on this same
# number; keep Vapi's SMS toggle OFF or it rewrites the messaging webhook.
TWILIO_FROM_NUMBER=
# Leave true until you have watched a dry run. true = nothing leaves the
# building; the whole path runs and the exact text is reported back.
DRY_RUN_SMS=true

# A2P 10DLC follows the DESTINATION, not the sender. A Canadian number texting
# Canadian recipients needs no registration. Texting a US number from it returns
# error 30034 until a Sole Proprietor brand and campaign are registered.

# ─── browser automation (M5) ─────────────────────────────────────────────────
BROWSER_ENABLED=false
BROWSER_ALLOWED_DOMAINS=amazon.com,www.amazon.com,smile.amazon.com
BROWSER_PROFILE_DIR=/data/browser-profile
DRY_RUN_BROWSER=true
# Hard monthly ceiling on agent-initiated spend, enforced in the policy engine.
PURCHASE_MONTHLY_CAP=200

# ─── ops ─────────────────────────────────────────────────────────────────────
DAILY_BUDGET_ALERT_USD=5
AUDIT_RETENTION_DAYS=90
# Optional: lets /improve file capability requests as GitHub issues.
GITHUB_TOKEN=
GITHUB_REPO=your-user/your-repo
