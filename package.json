{
  "name": "home-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "nyt:recipe-box": "tsx scripts/nyt-recipe-box.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "@anthropic-ai/sdk": "^0.122.0",
    "@hono/node-server": "^2.1.1",
    "@vapi-ai/server-sdk": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^178.0.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.5",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "rrule": "^2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
